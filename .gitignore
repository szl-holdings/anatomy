# SZL Living Anatomy — Docker Space: a Python runtime serving a vendored,
# no-build static atlas. Keep the tree clean: only the vendored bundle and
# sources should ever land here.

# local QA harness (qa_yarqa.js runs under Playwright/Chromium, installed locally)
node_modules/
package-lock.json
qa_*_results.json
qa_*.png

# generated at test/publish time (scripts/materialize_second_brain.py writes
# .runtime/; the live-witness workflow writes reports/) — never commit
.runtime/
reports/

# python tooling cruft (venvs, editable-install metadata, scans/linters)
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# environment / secrets — never commit
.env
.env.*

# editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
